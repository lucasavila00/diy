{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreWorkspaces": [
		"e2e-tests/failure",
		"e2e-tests/success/module-graph",
		"e2e-tests/success/module-resolution"
	],
	"ignoreIssues": {
		"packages/diy-analyzer/tsc-slim/out.js": ["exports"]
	},
	"workspaces": {
		".": {
			"entry": ["oxlint-plugin-local.mjs", "scripts/check-knip-workspaces.mjs"],
			"project": ["*.json", "*.mjs", "scripts/**/*.mjs"]
		},
		"packages/diy": {
			"entry": ["src/index.ts!", "src/capabilities.ts!", "script/fixup-package.mjs!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs!"]
		},
		"packages/diy-analyzer": {
			"entry": ["src/app/cli.ts!", "script/build.mjs!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs!", "tsc-slim/**/*!"]
		},
		"packages/diy-cli": {
			"entry": ["bin/index.js!"],
			"ignoreDependencies": ["oxc-parser"],
			"project": ["bin/**/*.js!"]
		}
	}
}
