{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreWorkspaces": [
		"e2e-tests",
		"v8-tests/failure",
		"v8-tests/success/module-graph",
		"v8-tests/success/module-resolution",
		"v8-tests/success/nested-callback-need",
		"v8-tests/success/renamed-capability-provide",
		"v8-tests/success/unrelated-capabilities-type"
	],
	"workspaces": {
		".": {
			"project": ["*.mjs"]
		},
		"packages/diy": {
			"entry": ["src/index.ts!", "src/capabilities.ts!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs"]
		},
		"packages/diy-analyzer": {
			"entry": ["src/analysis/analyze.ts!"],
			"project": ["src/**/*.ts!"]
		},
		"packages/diy-cli": {
			"entry": ["src/cli.ts!"],
			"project": ["bin/**/*.js!", "src/**/*.ts!"]
		},
		"packages/diy-cli-builder": {
			"project": ["script/**/*.mjs"]
		}
	}
}
