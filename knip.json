{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreWorkspaces": [
		"e2e-tests",
		"v8-tests/failure",
		"v8-tests/success/module-graph",
		"v8-tests/success/module-resolution",
		"v8-tests/success/nested-callback-need",
		"v8-tests/success/renamed-capability-provide",
		"v8-tests/success/unrelated-capabilities-type"
	],
	"workspaces": {
		".": {
			"entry": ["oxlint-plugin-local.mjs", "scripts/check-knip-workspaces.mjs"],
			"project": ["*.json", "*.mjs"]
		},
		"packages/diy": {
			"entry": ["src/index.ts!", "src/capabilities.ts!", "script/fixup-package.mjs!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs!"]
		},
		"packages/diy-analyzer": {
			"entry": [
				"src/core/analysis/analyze.ts!",
				"src/core/analysis/lint.ts!",
				"src/core/analysis/module-graph.ts!",
				"src/core/analysis/timing.ts!",
				"src/core/config/source-files.ts!"
			],
			"project": ["src/**/*.ts!"]
		},
		"packages/diy-cli": {
			"entry": ["bin/index.js!", "src/cli.ts!"],
			"ignoreDependencies": ["@typescript/native-preview"],
			"project": ["bin/**/*.js!", "src/**/*.ts!", "tsconfig.json!"]
		},
		"packages/diy-cli-builder": {
			"entry": ["script/build.mjs!"],
			"project": ["package.json!", "script/**/*.mjs!"]
		}
	}
}
