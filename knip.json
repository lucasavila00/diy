{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreWorkspaces": ["e2e-tests/failure", "e2e-tests/success/module-graph"],
	"workspaces": {
		".": {
			"entry": ["oxlint-plugin-local.mjs", "scripts/check-knip-workspaces.mjs"],
			"project": ["*.json", "*.mjs", "scripts/**/*.mjs"]
		},
		"packages/diy": {
			"entry": ["src/index.ts!", "src/capabilities.ts!", "script/fixup-package.mjs!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs!"]
		},
		"packages/diy-cli": {
			"entry": ["bin/index.cjs!", "src/app/cli.ts!", "script/fixup-package.mjs!"],
			"project": ["src/**/*.ts!", "script/**/*.mjs!", "bin/**/*.cjs!"]
		}
	}
}
