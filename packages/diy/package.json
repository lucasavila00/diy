{
	"name": "@beff/diy",
	"version": "0.0.23",
	"files": [
		"dist/cjs",
		"dist/esm",
		"dist/types"
	],
	"type": "module",
	"main": "dist/cjs/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./capabilities": {
			"types": "./dist/types/capabilities.d.ts",
			"require": "./dist/cjs/capabilities.js",
			"import": "./dist/esm/capabilities.js",
			"default": "./dist/esm/capabilities.js"
		}
	},
	"scripts": {
		"build": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json && node ./script/fixup-package.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
